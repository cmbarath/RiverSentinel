# River Sentinel 2.0 - Backend Environment Configuration Template
# Copy this file to backend/.env and fill in the values.
# NEVER commit the real .env file to Git!

# Flask Server Configuration
PORT=5000
FLASK_ENV=development

# Supabase PostgreSQL Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Publishable anon key (safe for read-only queries protected by RLS)
SUPABASE_KEY=sb_publishable_your_anon_key_here
# Secret service role key (strictly server-side; used for authenticated persistence)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here

# Groq Cloud AI API Key (for Qwen 3.8 27B Chatbot and Vision Image Analysis)
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Telemetry Simulator Authentication Token
# Shared secret used by backend/simulate_sensors.py to authenticate against /api/telemetry/simulate
SIMULATOR_API_TOKEN=your_secure_simulator_token_here
