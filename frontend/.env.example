# River Sentinel 2.0 - Frontend Environment Configuration Template
# Copy this file to frontend/.env.local and fill in your values.
# NEVER commit .env.local to Git!

# Backend API Endpoint
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Supabase Public Configuration (Protected by Row-Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Publishable anon key (safe for browser; NEVER put service_role or secret keys here!)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here
